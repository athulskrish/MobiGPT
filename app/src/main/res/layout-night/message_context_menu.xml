<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/context_menu_background"
    android:orientation="vertical"
    android:padding="8dp"
    android:elevation="8dp"
    android:minWidth="160dp">

    <LinearLayout
        android:id="@+id/btn_copy_message"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:minWidth="120dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_copy"
            android:contentDescription="@null"
            app:tint="@color/text_primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_copy"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:alpha="0.3" />

    <LinearLayout
        android:id="@+id/btn_star_message"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:minWidth="120dp">

        <ImageView
            android:id="@+id/icon_star"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="@null"
            app:tint="@color/text_primary_dark" />

        <TextView
            android:id="@+id/text_star_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_star"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:id="@+id/divider_before_regenerate"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:alpha="0.3" />

    <LinearLayout
        android:id="@+id/btn_regenerate_message"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:minWidth="120dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_regenerate"
            android:contentDescription="@null"
            app:tint="@color/text_primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_regenerate"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:id="@+id/divider_before_retry"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:alpha="0.3" />

    <LinearLayout
        android:id="@+id/btn_retry_message"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:minWidth="120dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_regenerate"
            android:contentDescription="@null"
            app:tint="@color/text_primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_retry"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:alpha="0.3" />

    <LinearLayout
        android:id="@+id/btn_share_message"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:minWidth="120dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_share"
            android:contentDescription="@null"
            app:tint="@color/text_primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_share"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark"
        android:alpha="0.3" />

    <LinearLayout
        android:id="@+id/btn_select_multiple"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:minWidth="120dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_select_multiple"
            android:contentDescription="@null"
            app:tint="@color/text_primary_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_select_multiple"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>