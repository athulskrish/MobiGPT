<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottom_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:id="@+id/bottom_sheet_drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_sheet_drag_handle" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/text_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select AI Model"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/textColorPrimary" />

        <TextView
            android:id="@+id/text_model_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/model_tag_badge_background"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?attr/textColorSecondary"
            tools:text="14 Available" />

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btn_close_model_selection"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            android:scaleType="centerInside"
            android:padding="6dp"
            app:tint="?attr/textColorSecondary" />

    </LinearLayout>

    <!-- Search Bar Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_box_background"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"
                app:tint="?attr/textColorSecondary" />

            <EditText
                android:id="@+id/edit_search_model"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:hint="Search models, family, or size..."
                android:textSize="13sp"
                android:textColor="?attr/textColorPrimary"
                android:textColorHint="?attr/textColorSecondary"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear search"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:visibility="gone"
                app:tint="?attr/textColorSecondary" />

        </LinearLayout>

    </LinearLayout>

    <!-- Sleek Hardware Readiness & RAM Status Strip -->
    <LinearLayout
        android:id="@+id/layout_device_telemetry_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/hardware_banner_background">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_model_hub"
            app:tint="?attr/colorPrimary"
            android:contentDescription="Hardware" />

        <TextView
            android:id="@+id/text_device_telemetry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="⚡ 1.3 GB Free RAM · Fits ≤ 3B models"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="?attr/textColorPrimary"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Kept hidden for compatibility -->
        <TextView
            android:id="@+id/text_ram_advisor_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/badge_memory_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal RAM"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="@color/green_700"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/model_status_badge_optimal" />

    </LinearLayout>

    <!-- Quick Filter Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center"
                android:text="All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/model_filter_chip_text_color"
                android:background="@drawable/model_filter_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_downloaded"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center"
                android:text="Downloaded"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/model_filter_chip_text_color"
                android:background="@drawable/model_filter_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_compatible"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center"
                android:text="⚡ Fits RAM"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/model_filter_chip_text_color"
                android:background="@drawable/model_filter_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_coding"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center"
                android:text="💻 Coding"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/model_filter_chip_text_color"
                android:background="@drawable/model_filter_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_filter_compact"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:gravity="center"
                android:text="🪶 Compact"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/model_filter_chip_text_color"
                android:background="@drawable/model_filter_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <!-- Import Custom GGUF Chip -->
            <LinearLayout
                android:id="@+id/btn_download_from_url"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/model_import_button_background"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_add"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Import" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Import GGUF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dividerColor" />

    <!-- Empty State Layout -->
    <LinearLayout
        android:id="@+id/layout_model_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_search"
            android:contentDescription="No models"
            app:tint="?attr/textColorSecondary"
            android:alpha="0.6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No models found"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Try adjusting your search query or filters"
            android:textSize="12sp"
            android:textColor="?attr/textColorSecondary" />

        <TextView
            android:id="@+id/btn_empty_reset_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reset Filters"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Model List RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_model_selection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="16dp" />

</LinearLayout>
