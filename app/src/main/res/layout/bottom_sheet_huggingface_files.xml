<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bottom_sheet_drag_handle" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_model_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/textColorPrimary"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Llama-3.2-3B-Instruct-GGUF" />

            <TextView
                android:id="@+id/tv_sheet_model_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="?attr/textColorSecondary"
                tools:text="by bartowski • Select a quantization file" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_files_sheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Close"
            android:scaleType="centerInside"
            android:padding="6dp"
            app:tint="?attr/textColorSecondary" />

    </LinearLayout>

    <!-- Device RAM Info Banner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/borderColor"
        app:cardBackgroundColor="?attr/surfaceColor">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_device"
                app:tint="?attr/colorPrimary"
                android:contentDescription="RAM Info" />

            <TextView
                android:id="@+id/tv_sheet_device_ram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textColor="?attr/textColorSecondary"
                tools:text="Device RAM: 8.0 GB (4.2 GB Free) • Q4_K_M is recommended" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dividerColor"
        android:layout_marginBottom="8dp" />

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/layout_files_loading"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Fetching repository files..."
            android:textSize="13sp"
            android:textColor="?attr/textColorSecondary" />

    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/layout_files_error"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_error"
            app:tint="?attr/textColorSecondary"
            android:contentDescription="Error" />

        <TextView
            android:id="@+id/tv_files_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Failed to load files"
            android:textSize="13sp"
            android:textColor="?attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_files"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:text="Retry"
            android:textSize="12sp"
            android:textAllCaps="false"
            app:cornerRadius="18dp" />

    </LinearLayout>

    <!-- Files RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        tools:listitem="@layout/item_huggingface_file" />

</LinearLayout>
