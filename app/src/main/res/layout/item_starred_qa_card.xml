<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_starred_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/borderColor"
    app:cardBackgroundColor="?attr/surfaceColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Chat Title Pill, Timestamp, and Gold Star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Chat Title Badge -->
            <LinearLayout
                android:id="@+id/layout_chat_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/starred_chat_badge_background">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_history_chat"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Chat" />

                <TextView
                    android:id="@+id/text_chat_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Conversation"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_starred_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:text="Today"
                android:textSize="11.5sp"
                android:textColor="?attr/textColorSecondary" />

            <!-- Gold Star Unstar Action -->
            <ImageButton
                android:id="@+id/btn_unstar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/star_color"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:contentDescription="Unstar message" />

        </LinearLayout>

        <!-- Question / Prompt Section -->
        <LinearLayout
            android:id="@+id/layout_question_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/starred_question_background"
            android:padding="12dp">

            <!-- Question Label Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_chat_bubble"
                    app:tint="?attr/textColorSecondary"
                    android:contentDescription="User question" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="QUESTION"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textColorSecondary"
                    android:letterSpacing="0.04" />

            </LinearLayout>

            <!-- Question Content -->
            <TextView
                android:id="@+id/text_question_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User prompt goes here..."
                android:textSize="14.5sp"
                android:textStyle="normal"
                android:textColor="?attr/textColorPrimary"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true" />

        </LinearLayout>

        <!-- Flow Connector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="16dp"
                android:layout_height="1dp"
                android:background="?attr/dividerColor" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/colorPrimary"
                android:alpha="0.8"
                android:contentDescription="Arrow" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="?attr/dividerColor" />

        </LinearLayout>

        <!-- Response Section -->
        <LinearLayout
            android:id="@+id/layout_response_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Response Label Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_developer"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="AI Response" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="AI RESPONSE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.04" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/text_token_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="38 token/s"
                    android:textSize="10.5sp"
                    android:textColor="?attr/textColorSecondary"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Thinking Process Accordion (for DeepSeek-R1 / Reasoning models) -->
            <LinearLayout
                android:id="@+id/container_thinking_process"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/thinking_container_background"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/layout_thinking_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/text_thinking_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thought Process (Complete)"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textColorSecondary" />

                    <ImageView
                        android:id="@+id/icon_thinking_chevron"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="?attr/textColorSecondary"
                        android:contentDescription="Expand thinking" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_thinking_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/dividerColor"
                        android:layout_marginBottom="6dp"
                        android:alpha="0.4" />

                    <TextView
                        android:id="@+id/text_thinking_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/textColorSecondary"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Response Text Content -->
            <TextView
                android:id="@+id/text_response_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI response text goes here..."
                android:textSize="15sp"
                android:textColor="?attr/textColorPrimary"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true" />

        </LinearLayout>

        <!-- Bottom Action Bar Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/dividerColor"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp" />

        <!-- Bottom Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Copy Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Copy"
                android:textSize="12.5sp"
                android:textColor="?attr/textColorSecondary"
                app:icon="@drawable/ic_copy"
                app:iconSize="15dp"
                app:iconTint="?attr/textColorSecondary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="10dp" />

            <!-- Share Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Share"
                android:textSize="12.5sp"
                android:textColor="?attr/textColorSecondary"
                app:icon="@drawable/ic_share"
                app:iconSize="15dp"
                app:iconTint="?attr/textColorSecondary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="10dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Open in Chat Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_chat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Open Chat"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_chevron_right"
                app:iconSize="16dp"
                app:iconTint="?attr/colorPrimary"
                app:iconGravity="textEnd"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
