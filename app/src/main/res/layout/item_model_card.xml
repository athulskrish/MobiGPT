<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_model"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/surfaceColor"
    app:strokeColor="?attr/borderColor"
    app:strokeWidth="1dp"
    app:rippleColor="?attr/colorControlHighlight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Brand Avatar Container -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/model_icon_container_background">

            <ImageView
                android:id="@+id/model_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat_bubble"
                android:contentDescription="@string/model_icon"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/model_avatar_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="Q" />

        </FrameLayout>

        <!-- Model details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <!-- Title & Status Pill Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Qwen 2.5 0.5B"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textColorPrimary"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/model_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    tools:text="● Active"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/model_status_badge_active"
                    android:textColor="@color/green_700"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Human-Centric Benefit / Purpose Description (Non-Redundant) -->
            <TextView
                android:id="@+id/text_model_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Ultra-fast and lightweight assistant for everyday chat"
                android:textSize="11.5sp"
                android:textColor="?attr/textColorSecondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Single Unified Specs & RAM Status Line (Zero Horizontal Scroll Clutter) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- File Size -->
                <TextView
                    android:id="@+id/text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="468.6 MB"
                    android:textSize="11sp"
                    android:textColor="?attr/textColorSecondary"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <!-- Dot Divider -->
                <TextView
                    android:id="@+id/spec_dot_param"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="11sp"
                    android:textColor="?attr/textColorSecondary"
                    android:visibility="gone" />

                <!-- Parameter Tag (shown if not in title) -->
                <TextView
                    android:id="@+id/tag_params"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0.5B"
                    android:textSize="11sp"
                    android:textColor="?attr/textColorSecondary"
                    android:singleLine="true"
                    android:visibility="gone" />

                <!-- Dot Divider -->
                <TextView
                    android:id="@+id/spec_dot_quant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="11sp"
                    android:textColor="?attr/textColorSecondary" />

                <!-- Quantization Tag -->
                <TextView
                    android:id="@+id/tag_quant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Q4"
                    android:textSize="11sp"
                    android:textColor="?attr/textColorSecondary"
                    android:singleLine="true" />

                <!-- Dot Divider -->
                <TextView
                    android:id="@+id/spec_dot_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="11sp"
                    android:textColor="?attr/textColorSecondary" />

                <!-- RAM Compatibility Status (Calm green text or warning badge) -->
                <TextView
                    android:id="@+id/tag_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="● Fits RAM"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_700"
                    android:singleLine="true"
                    android:ellipsize="none" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Button (Download or Delete) -->
        <ImageButton
            android:id="@+id/btn_action"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_model_download_background"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/download_delete_model"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
