        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="?attr/textColorSecondary"
        android:alpha="0.75"
        tools:text="TODAY" />

</LinearLayout>
