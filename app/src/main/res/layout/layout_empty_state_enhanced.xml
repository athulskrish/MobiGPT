<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/empty_state_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/empty_state_enhanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center">

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_empty_state"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            app:lottie_rawRes="@raw/chat_animation"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_speed="1.0" />

        <!-- Title -->
        <TextView
            android:id="@+id/text_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="MobiGPT AI Studio"
            android:textColor="?attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/text_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="100% On-Device • Private &amp; Offline"
            android:textColor="?attr/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:alpha="0.85" />

        <!-- Suggestion Chips Title -->
        <TextView
            android:id="@+id/text_suggestions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Try asking:"
            android:textColor="?attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:alpha="0.9" />

    <!-- Suggestion Prompts 2x2 Responsive Grid (No horizontal clipping) -->
    <LinearLayout
        android:id="@+id/suggestions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- First row of prompt cards -->
        <LinearLayout
            android:id="@+id/suggestion_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- 2 Cards added programmatically with equal weight -->
        </LinearLayout>

        <!-- Second row of prompt cards -->
        <LinearLayout
            android:id="@+id/suggestion_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- 2 Cards added programmatically with equal weight -->
        </LinearLayout>

    </LinearLayout>

    <!-- Separator with icons -->
    <View
        android:layout_width="80dp"
        android:layout_height="1dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="?attr/textColorSecondary"
        android:alpha="0.2" />

    <!-- Quick Action: View Chat History -->
    <LinearLayout
        android:id="@+id/btn_view_chat_history_enhanced"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_menu"
            android:layout_marginEnd="8dp"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View chat history"
            android:textColor="?attr/textColorSecondary"
            android:textSize="13sp"
            android:alpha="0.8" />

    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>
