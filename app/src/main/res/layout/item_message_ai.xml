<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:id="@+id/message_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/ai_message_background"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_percent="0.94"
        app:layout_constraintWidth_min="100dp">

        <!-- Selection indicator -->
        <ImageView
            android:id="@+id/selection_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start"
            android:layout_marginBottom="4dp"
            android:src="@android:drawable/checkbox_on_background"
            app:tint="?attr/colorPrimary"
            android:visibility="gone"
            android:contentDescription="Selected"
            tools:visibility="visible" />

        <!-- Typing indicator (3 animated dots) - shown when AI is thinking -->
        <LinearLayout
            android:id="@+id/typing_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <View
                android:id="@+id/typing_dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/typing_dot"
                android:alpha="0.3" />

            <View
                android:id="@+id/typing_dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/typing_dot"
                android:alpha="0.3" />

            <View
                android:id="@+id/typing_dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/typing_dot"
                android:alpha="0.3" />

        </LinearLayout>

        <!-- DeepSeek-R1 / Reasoning / Thinking Process Accordion -->
        <LinearLayout
            android:id="@+id/container_thinking_process"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:background="@drawable/thinking_container_background"
            android:visibility="gone">

            <!-- Header (Clickable to expand/collapse) -->
            <LinearLayout
                android:id="@+id/layout_thinking_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_thinking_brain"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_developer"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Thinking process" />

                <TextView
                    android:id="@+id/text_thinking_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thinking Process"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textColorSecondary" />

                <ImageView
                    android:id="@+id/icon_thinking_chevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/textColorSecondary"
                    android:contentDescription="Toggle thinking" />

            </LinearLayout>

            <!-- Collapsible Body -->
            <LinearLayout
                android:id="@+id/layout_thinking_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/dividerColor"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/text_thinking_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12.5sp"
                    android:textColor="?attr/textColorSecondary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Main text response -->
        <TextView
            android:id="@+id/text_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI response text"
            android:textColor="?attr/textColorPrimary"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:letterSpacing="0.01"
            android:textIsSelectable="true"
            android:contentDescription="AI response message"
            android:importantForAccessibility="yes"
            tools:text="Sample AI response that might be quite long to test the maximum width constraint and ensure proper text wrapping" />

        <!-- Container for dynamically added code blocks -->
        <LinearLayout
            android:id="@+id/container_code_blocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Quick Action Bar & Metadata -->
        <LinearLayout
            android:id="@+id/layout_message_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Metadata info (timestamp & speed) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/star_indicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="?attr/colorPrimary"
                    android:visibility="gone"
                    android:contentDescription="Starred message"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:30 PM"
                    android:textColor="?attr/textColorSecondary"
                    android:textSize="@dimen/text_sm"
                    android:alpha="0.75"
                    android:contentDescription="Message timestamp"
                    tools:text="12:30 PM" />

                <TextView
                    android:id="@+id/text_token_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="10.5 tok/s"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold"
                    android:alpha="0.85"
                    android:visibility="gone"
                    android:contentDescription="Token generation speed"
                    tools:text="10.5 tok/s"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Direct 1-tap Action Buttons -->
            <LinearLayout
                android:id="@+id/layout_quick_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Quick Copy Button -->
                <ImageButton
                    android:id="@+id/btn_quick_copy"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_copy"
                    android:padding="8dp"
                    android:src="@drawable/ic_copy"
                    app:tint="?attr/textColorSecondary" />

                <!-- Quick Regenerate Button -->
                <ImageButton
                    android:id="@+id/btn_quick_regenerate"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_regenerate"
                    android:padding="8dp"
                    android:src="@drawable/ic_regenerate"
                    app:tint="?attr/textColorSecondary" />

                <!-- Quick Share Button -->
                <ImageButton
                    android:id="@+id/btn_quick_share"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_share"
                    android:padding="8dp"
                    android:src="@drawable/ic_share"
                    app:tint="?attr/textColorSecondary" />

                <!-- Quick Star Button -->
                <ImageButton
                    android:id="@+id/btn_star_toggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_star"
                    android:padding="8dp"
                    android:src="@drawable/ic_star_outline"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
